"""Honeymoon - A minimal C++23 terminal text editor"""

module(
    name = "honeymoon",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "googletest", version = "1.17.0")

# Patch googletest to add cc_library load for Bazel 9 compatibility
single_version_override(
    module_name = "googletest",
    version = "1.17.0",
    patches = ["//third_party:googletest_bazel9.patch"],
    patch_strip = 1,
)
